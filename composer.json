{
    "name": "pr4w/laravel-ecosystem",
    "description": "Catalogue partagé des apps pr4w pour afficher des liens croisés entre produits.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "ecosystem", "cross-promotion"],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Pr4w\\Ecosystem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pr4w\\Ecosystem\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pr4w\\Ecosystem\\EcosystemServiceProvider"
            ],
            "aliases": {
                "Ecosystem": "Pr4w\\Ecosystem\\Facades\\Ecosystem"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
